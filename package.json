{
  "name": "voxfab-ai",
  "version": "1.3.8",
  "description": "System-wide voice-to-text desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac:apple-silicon": "electron-builder --mac dmg --arm64 && node scripts/rename-mac-dmgs.js arm64",
    "build:mac:intel": "electron-builder --mac dmg --x64 && node scripts/rename-mac-dmgs.js x64",
    "build:mac:both-dmg": "npm run build:mac:apple-silicon && npm run build:mac:intel"
  },
  "build": {
    "appId": "com.personal.voxfab-ai",
    "productName": "VoxFab AI",
    "publish": [
      {
        "provider": "github",
        "owner": "icelanderus",
        "repo": "VoxFab-AI"
      }
    ],
    "compression": "maximum",
    "dmg": {
      "title": "VoxFab AI ${version}",
      "artifactName": "VoxFab-AI-${version}-macOS-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "VoxFab-AI-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis-web"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack-icon.js",
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "VoxFab-AI-Web-Setup-${version}.${ext}",
      "appPackageUrl": "https://github.com/icelanderus/VoxFab-AI/releases/download/v${version}"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**/*",
      "scripts/**/*"
    ],
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!**/node_modules/onnxruntime-node/**",
      "!**/node_modules/openai/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!build/**",
      "!scripts/after-pack-icon.js",
      "!scripts/patch-icon-v2.js",
      "!dist",
      "!dist-final",
      "!release",
      "!VoxFab-AI-*-Standalone",
      "!Voice To Text-win32-x64",
      "!*.zip",
      "!*.lnk",
      "!*.bat",
      "!*.vbs",
      "!.git"
    ]
  },
  "keywords": [
    "voice",
    "speech",
    "text",
    "transcription"
  ],
  "author": "Ilya Tsuprun",
  "license": "CC-BY-NC-SA-4.0",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "electron-store": "^10.0.0",
    "openai": "^4.0.0"
  }
}
