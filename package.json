{
  "name": "my-tts-app",
  "version": "1.0.0",
  "description": "System-wide voice-to-text desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.personal.voice-to-text",
    "productName": "Voice To Text",
    "win": {
      "target": ["zip", "portable"],
      "icon": "assets/icon.png",
      "sign": null
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ]
  },
  "keywords": ["voice", "speech", "text", "transcription"],
  "author": "Personal",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "electron-store": "^10.0.0",
    "openai": "^4.0.0"
  }
}
